# === Python & Виртуальные окружения ===
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so

# === Переменные окружения (КРИТИЧНО!) ===
.env
.env.*

# === Firebase и Ключи ===
# Обязательно убедись, что файл с ключами (например, firebase-adminsdk.json) подпадает под эту маску
*firebase*.json
*serviceAccount*.json
credentials.json

# === PyCharm и IDE ===
.idea/
.vscode/
*.swp

# === Базы данных и Логи ===
*.sqlite3
*.log

# === Кэш сборочных скриптов ===
# scripts/.cache — скачанный free-exercise-db (~100 МБ картинок), пересобирается
# ingest_exercise_images.py. В репозитории не нужен.
scripts/.cache/

# === ML-артефакты классификатора упражнений ===
# В репозитории лежит ОБРЕЗАННЫЙ под наш домен эмбеддер (api/data/embedder,
# ~66 МБ) — он помещается в обычные git-блобы, LFS для него не нужен.
# Исходная необрезанная модель (578 МБ) нужна только чтобы повторить обрезку
# скриптом scripts/prune_embedder_vocab.py и в историю не едет.
api/data/embedder_full/

# Сгенерированные ingest_exercise_images.py страницы ручного ревью картинок.
scripts/review.html
scripts/review-propagate.html
